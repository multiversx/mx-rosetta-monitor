# --- images / refs ---
ROSETTA_REF=main
MESH_CLI_REF=master
MESH_CLI_REPO=https://github.com/coinbase/mesh-cli.git
MONITOR_POLL_INTERVAL_SEC=30

# --- network (mainnet defaults, mirrors mx-chain-rosetta/cmd/rosetta/cli.go) ---
NETWORK_ID=1
NETWORK_NAME=mainnet
NATIVE_CURRENCY=EGLD
NUM_SHARDS=3
GENESIS_BLOCK=cd229e4ad2753708e4bab01d7f249affe29441829524c9529e84d51b6d12f2a7

# --- gateway -> observer adapter (mirrors systemtests/check_with_mesh_cli.py) ---
# Rosetta never talks to the gateway directly. Each rosetta-N talks to
# adapter-N (proxyToObserverAdapter binary), which forwards observer-style
# requests to the gateway: --proxy=$PROXY_URL --shard=N --port=1000X.
PROXY_URL=
ADAPTER_DELAY_MS=0
ADAPTER_PORT_0=10001
ADAPTER_PORT_1=10002
ADAPTER_PORT_2=10003
ADAPTER_PORT_META=10004

# Advanced: bypass the adapter with your own full-archive observers.
# If you set these, point each rosetta service at them via a compose override
# (default compose always uses the adapter above).
# DIRECT_OBSERVER_URL_0=http://my-observer-0:8080
# DIRECT_OBSERVER_URL_1=http://my-observer-1:8080
# DIRECT_OBSERVER_URL_2=http://my-observer-2:8080
# DIRECT_OBSERVER_URL_META=http://my-observer-meta:8080

# Historical window. Must match observer DB.
# See mx-chain-rosetta pruning docs: first = oldest_epoch + 2, num = N kept.
FIRST_HISTORICAL_EPOCH=1500
NUM_HISTORICAL_EPOCHS=4

# --- ports (host bindings) ---
ROSETTA_PORT_0=7091
ROSETTA_PORT_1=7092
ROSETTA_PORT_2=7093
ROSETTA_PORT_META=7094
MESH_STATUS_PORT_0=9091
MESH_STATUS_PORT_1=9092
MESH_STATUS_PORT_2=9093
MESH_STATUS_PORT_META=9094
MONITOR_PORT=8081
PROM_PORT=9090

# --- alerting ---
SLACK_WEBHOOK_URL=

# --- grafana ---
GRAFANA_PORT=3000

# --- loki ---
LOKI_PORT=3100
LOKI_VERSION=3.2.1

CADVISOR_PORT=8082
CADVISOR_VERSION=v0.60.6

# Go GC soft heap limit per mesh-cli (caps RAM growth, costs some CPU). Lower to tighten, raise if OOMs.
MESH_GOMEMLIMIT=2GiB
