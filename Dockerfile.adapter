# Builds proxyToObserverAdapter from mx-chain-rosetta/systemtests.
# Same ROSETTA_REF as rosetta so adapter matches the tested code.
# Default branch is main (there is no master on mx-chain-rosetta).
ARG ROSETTA_REF=main
FROM golang:1.26-bookworm AS build
ARG ROSETTA_REF
RUN git clone --branch ${ROSETTA_REF} --depth 1 https://github.com/multiversx/mx-chain-rosetta.git /src \
 && cd /src && go build -o /out/adapter ./systemtests/proxyToObserverAdapter.go

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/adapter /usr/local/bin/adapter
EXPOSE 10001
ENTRYPOINT ["/usr/local/bin/adapter"]
